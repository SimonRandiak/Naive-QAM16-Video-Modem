    run_command: '{python} -u {filename}'
    thread_safe_setters: ''
    title: QAM16 video link Transmitter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

