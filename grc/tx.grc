- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\nimport pmt\nimport binascii\n\nSYNC_WORD = np.frombuffer(\n\
      \    (0x1ACFFC1D).to_bytes(4, \"big\"),\n    dtype=np.uint8\n)\n\nclass blk(gr.sync_block):\
      \  # other base classes are basic_block, decim_block, interp_block\n    \"\"\
      \"Embedded Python Block example - a simple multiply const\"\"\"\n\n    def __init__(self):\
      \  # only default arguments here\n        \"\"\"arguments to this function show\
      \ up as parameters in GRC\"\"\"\n        gr.sync_block.__init__(\n         \
      \   self,\n            name='Video packetizer',   # will show up in GRC\n  \
      \          in_sig=None,\n            out_sig=None\n        )\n\n        self.message_port_register_out(pmt.intern('msg_out'))\n\
      \        self.message_port_register_in(pmt.intern('msg_in'))\n        # if an\
      \ attribute with the same name as a parameter is found,\n        # a callback\
      \ is registered (properties work, too).\n        self.set_msg_handler(pmt.intern('msg_in'),\
      \ self.create_frame)\n\n    def create_frame(self, msg):\n        metadata =\
      \ pmt.car(msg)\n        payload = pmt.cdr(msg)\n\n        data = np.array(\n\
      \            pmt.u8vector_elements(payload),\n            dtype=np.uint8\n \
      \       )\n\n        packet_len = len(data)\n\n        packet_len = np.frombuffer(\n\
      \            packet_len.to_bytes(2, byteorder=\"big\"),\n            dtype=np.uint8\n\
      \        )\n\n        crc = binascii.crc_hqx(data.tobytes(), 0xFFFF)\n\n   \
      \     crc_bytes = np.frombuffer(\n            crc.to_bytes(2, byteorder=\"big\"\
      ),\n            dtype=np.uint8\n        )\n\n\n        packet = np.concatenate([\n\
      \            SYNC_WORD,\n            packet_len,\n            data,\n      \
      \      crc_bytes\n        ])\n\n        packet_pmt = pmt.init_u8vector(\n  \
      \          len(packet),\n            packet.tolist()\n        )\n\n        pdu\
      \ = pmt.cons(\n            pmt.PMT_NIL,\n            packet_pmt\n        )\n\
      \n        self.message_port_pub(\n            pmt.intern(\"msg_out\"),\n   \
      \         pdu\n        )\n\n\n\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Video packetizer', 'blk', [], [('msg_in', 'message', 1)], [('msg_out',
      'message', 1)], 'Embedded Python Block example - a simple multiply const', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [304, 292.0]
    rotation: 0
    state: enabled
