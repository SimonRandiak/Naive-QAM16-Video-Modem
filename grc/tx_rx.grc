    attenuation1: '7.0'
    bandwidth: '20000000'
    buffer_size: '32768'
    comment: ''
    cyclic: 'False'
    filter: ''
    filter_source: '''Auto'''
    fpass: '0'
    frequency: int(433e6)
    fstop: '0'
    len_tag_key: ''
    samplerate: samp_rate
    type: fc32
    uri: ip:192.168.1.90
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1144, 144.0]
    rotation: 0
    state: enabled
- name: network_socket_pdu_0
  id: network_socket_pdu
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    host: 127.0.0.1
    maxoutbuf: '0'
    minoutbuf: '0'
    mtu: '40_000'
    port: '1234'
    tcp_no_delay: 'False'
    type: UDP_SERVER
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [112, 308.0]
    rotation: 0
    state: enabled

connections:
- [digital_constellation_modulator_0, '0', iio_pluto_sink_0, '0']
- [epy_block_0, '0', digital_constellation_modulator_0, '0']
- [network_socket_pdu_0, pdus, epy_block_0, msg_in]

metadata:
  file_format: 1
  grc_version: 3.10.9.2
